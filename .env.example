# 数据库 - Neon PostgreSQL (从 https://neon.tech 获取)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Stripe - 从 https://dashboard.stripe.com/apikeys 获取
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# JWT Secret - 用于用户登录认证 (已存在)
JWT_SECRET=your-jwt-secret-here

# Resend - 邮件发送 (从 https://resend.com/api-keys 获取)
# 免费套餐每天 100 封，适合初期使用
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Zen Craft Bracelets <noreply@yourdomain.com>

# 网站域名 (开发环境用 localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3457
